<article class="stb-card stb-card--{{kind}} stb-card--{{visibilityKey}}{{#if complete}} is-complete{{/if}}{{#if expired}} is-expired{{/if}}" data-clock-id="{{id}}" style="--stb-clock-color: {{color}};">
  <div class="stb-card__pie" data-action="edit" title="{{stbT 'Board.openClock'}}">{{{pie}}}</div>
  <div class="stb-card__body">
    <header class="stb-card__header">
      <i class="{{icon}} stb-card__icon"></i>
      <h4 class="stb-card__name" data-action="edit" title="{{name}}">{{name}}</h4>
      <span class="stb-card__visibility" title="{{visibility}}">
        {{#if isGMOnly}}<i class="fa-solid fa-eye-slash"></i>{{/if}}
        {{#if isPlayers}}<i class="fa-solid fa-eye"></i>{{/if}}
        {{#if isActor}}<i class="fa-solid fa-user"></i>{{/if}}
      </span>
    </header>
    <div class="stb-card__kind">{{kindLabel}}</div>
    <div class="stb-card__state">{{state}}</div>
    {{#if actorName}}
      <div class="stb-card__meta" data-actor-uuid="{{actorUuid}}"><a data-action="openActor"><i class="fa-solid fa-user"></i> {{actorName}}</a></div>
    {{/if}}
    {{#if actorMissing}}<div class="stb-card__warning"><i class="fa-solid fa-triangle-exclamation"></i> {{stbT 'Board.actorMissing'}}</div>{{/if}}
    {{#if ownerName}}<div class="stb-card__meta"><i class="fa-solid fa-user-pen"></i> {{stbT 'Board.owner' name=ownerName}}</div>{{/if}}
    {{#if nextLabel}}<div class="stb-card__meta"><i class="fa-solid fa-forward-step"></i> {{stbT 'Board.nextState' label=nextLabel}}</div>{{/if}}
    {{#if effectLink}}<div class="stb-card__effect">{{{effectLink}}}</div>{{/if}}
    {{#if next}}<div class="stb-card__next"><i class="fa-regular fa-clock"></i> {{next}}</div>{{/if}}
    {{#if lastChangeText}}<div class="stb-card__last">{{lastChangeText}}</div>{{/if}}
    {{#if expired}}<div class="stb-card__expired"><i class="fa-solid fa-bell"></i> {{stbT 'Board.alarmExpired'}}{{#if completedAt}} · {{completedAt}}{{/if}}</div>{{/if}}
    {{#if pendingCount}}<div class="stb-card__meta stb-card__pending"><i class="fa-solid fa-inbox"></i> {{stbT 'Proposal.pending' n=pendingCount}}</div>{{/if}}
    {{#unless canControl}}{{#if canProposeAdvance}}{{#if canProposeNote}}{{else}}
      <div class="stb-card__controls"><button type="button" data-action="proposeAdvance" {{#if pendingCount}}disabled{{/if}}><i class="fa-solid fa-plus"></i> {{stbT 'Proposal.proposeAdvance'}}</button></div>
    {{/if}}{{else}}{{#if canProposeNote}}
      <div class="stb-card__controls"><button type="button" data-action="proposeNote"><i class="fa-solid fa-comment"></i> {{stbT 'Proposal.proposeNote'}}</button></div>
    {{/if}}{{/if}}{{/unless}}
    {{#if canControl}}
      <div class="stb-card__controls">
        {{#unless isAlarm}}
          <button type="button" data-action="retreat" data-delta="1" {{#unless canRetreat}}disabled{{/unless}} title="{{stbT 'Board.minusOne'}}" aria-label="{{stbT 'Board.minusOne'}}"><i class="fa-solid fa-minus"></i></button>
          <button type="button" data-action="advance" data-delta="1" {{#unless canAdvance}}disabled{{/unless}} title="{{stbT 'Board.plusOne'}}" aria-label="{{stbT 'Board.plusOne'}}"><i class="fa-solid fa-plus"></i></button>
          <button type="button" data-action="setExact" title="{{stbT 'Board.setExact'}}" aria-label="{{stbT 'Board.setExact'}}"><i class="fa-solid fa-hashtag"></i></button>
        {{/unless}}
        {{#if hasLabels}}<button type="button" data-action="setState" title="{{stbT 'Board.setState'}}" aria-label="{{stbT 'Board.setState'}}"><i class="fa-solid fa-list"></i></button>{{/if}}
        {{#if expired}}<button type="button" data-action="dismiss" title="{{stbT 'Board.dismiss'}}" aria-label="{{stbT 'Board.dismiss'}}"><i class="fa-solid fa-bell-slash"></i></button>{{/if}}
        <span class="stb-card__spacer"></span>
        <button type="button" data-action="edit" title="{{stbT 'Board.edit'}}" aria-label="{{stbT 'Board.edit'}}"><i class="fa-solid fa-pen"></i></button>
        <div class="stb-menu stb-card__menu">
          <button type="button" class="stb-menu__toggle" title="{{stbT 'Board.cardMenu'}}" aria-label="{{stbT 'Board.cardMenu'}}" aria-haspopup="true" aria-expanded="false"><i class="fa-solid fa-ellipsis"></i></button>
          <div class="stb-menu__items">
            <button type="button" data-action="complete" {{#if complete}}disabled{{/if}}><i class="fa-solid fa-flag-checkered"></i> {{stbT 'Board.complete'}}</button>
            <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{stbT 'Board.reset'}}</button>
            {{#if isGMOnly}}<button type="button" data-action="reveal"><i class="fa-solid fa-eye"></i> {{stbT 'Board.reveal'}}</button>{{/if}}
            {{#if isPlayers}}<button type="button" data-action="hide"><i class="fa-solid fa-eye-slash"></i> {{stbT 'Board.hide'}}</button>{{/if}}
            <hr>
            <button type="button" data-action="delete" class="stb-danger"><i class="fa-solid fa-trash"></i> {{stbT 'Board.delete'}}</button>
          </div>
        </div>
      </div>
    {{/if}}
  </div>
</article>
